{
  "name": "ember-terminal",
  "version": "0.3.2",
  "description": "A fast, block-based terminal for Windows",
  "main": "./out/main/index.js",
  "author": "dkflint723",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:units": "node scripts/test-secret-prompt.mjs",
    "verify": "npm run test:units && electron-vite build && node scripts/verify.mjs",
    "fetch:js-debug": "node scripts/fetch-js-debug.mjs",
    "package": "node scripts/fetch-js-debug.mjs && electron-vite build && electron-builder --win --dir",
    "dist": "node scripts/fetch-js-debug.mjs && electron-vite build && electron-builder --win",
    "verify:editor": "electron-vite build && node scripts/verify-editor.mjs",
    "verify:lsp": "electron-vite build && node scripts/verify-lsp.mjs",
    "verify:git": "electron-vite build && node scripts/verify-git.mjs",
    "verify:ide": "electron-vite build && node scripts/verify-ide.mjs",
    "verify:tabs": "electron-vite build && node scripts/verify-tabs.mjs",
    "verify:all": "npm run verify && node scripts/verify-editor.mjs && node scripts/verify-tabs.mjs && node scripts/verify-lsp.mjs && node scripts/verify-git.mjs && node scripts/verify-ide.mjs && node scripts/verify-github.mjs && node scripts/verify-explorer.mjs && node scripts/verify-session.mjs && node scripts/verify-notify.mjs && node scripts/verify-settings.mjs && node scripts/verify-search.mjs && node scripts/verify-palette.mjs && node scripts/verify-fileops.mjs && node scripts/verify-problems.mjs && node scripts/verify-vsix.mjs && node scripts/verify-panes.mjs && node scripts/verify-replace.mjs && node scripts/verify-keys.mjs && node scripts/verify-save.mjs && node scripts/verify-snippets.mjs && node scripts/verify-ai.mjs && node scripts/verify-lsp-root.mjs && node scripts/verify-claude-login.mjs && node scripts/verify-titlebar.mjs && node scripts/verify-output.mjs && node scripts/verify-navigate.mjs && node scripts/verify-contrast.mjs && node scripts/verify-a11y.mjs && node scripts/verify-reopen.mjs && node scripts/verify-modes.mjs && node scripts/verify-blocks.mjs && node scripts/verify-intent.mjs && node scripts/verify-statusbar.mjs && node scripts/verify-shell.mjs && npm run verify:packaged",
    "verify:github": "electron-vite build && node scripts/verify-github.mjs",
    "verify:explorer": "electron-vite build && node scripts/verify-explorer.mjs",
    "icon": "node scripts/build-icon.mjs",
    "verify:session": "electron-vite build && node scripts/verify-session.mjs",
    "verify:notify": "electron-vite build && node scripts/verify-notify.mjs",
    "verify:settings": "electron-vite build && node scripts/verify-settings.mjs",
    "verify:search": "electron-vite build && node scripts/verify-search.mjs",
    "verify:palette": "electron-vite build && node scripts/verify-palette.mjs",
    "verify:fileops": "electron-vite build && node scripts/verify-fileops.mjs",
    "verify:problems": "electron-vite build && node scripts/verify-problems.mjs",
    "verify:vsix": "electron-vite build && node scripts/verify-vsix.mjs",
    "verify:panes": "electron-vite build && node scripts/verify-panes.mjs",
    "verify:replace": "electron-vite build && node scripts/verify-replace.mjs",
    "verify:keys": "electron-vite build && node scripts/verify-keys.mjs",
    "verify:save": "electron-vite build && node scripts/verify-save.mjs",
    "verify:snippets": "electron-vite build && node scripts/verify-snippets.mjs",
    "verify:ai": "electron-vite build && node scripts/verify-ai.mjs",
    "verify:lsproot": "electron-vite build && node scripts/verify-lsp-root.mjs",
    "verify:packaged": "electron-builder --win --dir && node scripts/verify-packaged.mjs",
    "verify:login": "electron-vite build && node scripts/verify-claude-login.mjs",
    "verify:titlebar": "electron-vite build && node scripts/verify-titlebar.mjs",
    "verify:output": "electron-vite build && node scripts/verify-output.mjs",
    "verify:navigate": "electron-vite build && node scripts/verify-navigate.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:a11y": "electron-vite build && node scripts/verify-a11y.mjs",
    "verify:reopen": "electron-vite build && node scripts/verify-reopen.mjs",
    "verify:blocks": "electron-vite build && node scripts/verify-blocks.mjs",
    "verify:intent": "electron-vite build && node scripts/verify-intent.mjs",
    "verify:statusbar": "electron-vite build && node scripts/verify-statusbar.mjs",
    "verify:shell": "electron-vite build && node scripts/verify-shell.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@vscode/ripgrep": "^1.18.0",
    "adm-zip": "^0.6.0",
    "bash-language-server": "^5.6.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.56.0",
    "pyright": "^1.1.412",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "ws": "^8.21.3",
    "yaml-language-server": "^1.24.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.14",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "dev.dkflint.ember",
    "productName": "Ember",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/monaco-editor/**/*"
    ],
    "extraResources": [
      "resources/**"
    ],
    "asarUnpack": [
      "**/node_modules/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ember",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dkflint723",
        "repo": "ember-terminal"
      }
    ]
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "minimatch@10": "^10.2.3",
    "monaco-editor": {
      "dompurify": "^3.4.13"
    }
  }
}
