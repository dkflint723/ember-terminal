{
  "name": "Solar Dusk",
  "type": "dark",
  "colors": {
    "editor.background": "#002b36",
    "editor.foreground": "#93a1a1",
    "terminal.background": "#002b36",
    "terminal.foreground": "#93a1a1",
    "terminalCursor.foreground": "#b58900",
    "terminal.selectionBackground": "#0a4b5c",
    "titleBar.activeBackground": "#01313d",
    "editorWidget.background": "#073642",
    "list.hoverBackground": "#0a4451",
    "panel.border": "#0b4c5c",
    "input.border": "#1a6274",
    "descriptionForeground": "#839496",
    "disabledForeground": "#586e75",
    "focusBorder": "#b58900",
    "errorForeground": "#dc322f",
    "textLink.foreground": "#268bd2",

    "terminal.ansiBlack": "#073642",
    "terminal.ansiRed": "#dc322f",
    "terminal.ansiGreen": "#859900",
    "terminal.ansiYellow": "#b58900",
    "terminal.ansiBlue": "#268bd2",
    "terminal.ansiMagenta": "#d33682",
    "terminal.ansiCyan": "#2aa198",
    "terminal.ansiWhite": "#eee8d5",
    "terminal.ansiBrightBlack": "#586e75",
    "terminal.ansiBrightRed": "#cb4b16",
    "terminal.ansiBrightGreen": "#9fb800",
    "terminal.ansiBrightYellow": "#d4a017",
    "terminal.ansiBrightBlue": "#3aa0e0",
    "terminal.ansiBrightMagenta": "#e04a94",
    "terminal.ansiBrightCyan": "#35b8ae",
    "terminal.ansiBrightWhite": "#fdf6e3"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#586e75", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#2aa198" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#d33682" } },
    { "scope": "keyword", "settings": { "foreground": "#859900" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#93a1a1" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#268bd2" } },
    { "scope": "variable", "settings": { "foreground": "#b58900" } },
    { "scope": "invalid", "settings": { "foreground": "#dc322f" } }
  ]
}
