{
  "name": "Tidewater",
  "type": "dark",
  "colors": {
    "editor.background": "#0a1d24",
    "editor.foreground": "#dbe7ea",
    "terminal.background": "#0a1d24",
    "terminal.foreground": "#dbe7ea",
    "terminalCursor.foreground": "#6fd0e0",
    "terminal.selectionBackground": "#1b4450",
    "titleBar.activeBackground": "#0c2229",
    "editorWidget.background": "#12313a",
    "list.hoverBackground": "#173c46",
    "panel.border": "#163740",
    "input.border": "#23525e",
    "descriptionForeground": "#93a9ae",
    "disabledForeground": "#62807f",
    "focusBorder": "#6fd0e0",
    "errorForeground": "#e5636b",
    "textLink.foreground": "#6cc7e0",

    "terminal.ansiBlack": "#0a1d24",
    "terminal.ansiRed": "#e5636b",
    "terminal.ansiGreen": "#4ec98a",
    "terminal.ansiYellow": "#e3c079",
    "terminal.ansiBlue": "#6cc7e0",
    "terminal.ansiMagenta": "#bb9af7",
    "terminal.ansiCyan": "#6fd0e0",
    "terminal.ansiWhite": "#c9d8dc",
    "terminal.ansiBrightBlack": "#62807f",
    "terminal.ansiBrightRed": "#ff7b83",
    "terminal.ansiBrightGreen": "#6fe0a3",
    "terminal.ansiBrightYellow": "#f0d08e",
    "terminal.ansiBrightBlue": "#88dcf2",
    "terminal.ansiBrightMagenta": "#d0b4ff",
    "terminal.ansiBrightCyan": "#8fe4f0",
    "terminal.ansiBrightWhite": "#eef6f8"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#62807f", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#4ec98a" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#e3c079" } },
    { "scope": "keyword", "settings": { "foreground": "#bb9af7" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#6fd0e0" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#6cc7e0" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#6fd0e0" } },
    { "scope": "variable", "settings": { "foreground": "#dbe7ea" } },
    { "scope": "constant.language", "settings": { "foreground": "#e3c079" } }
  ]
}
