{
  "name": "Midnight",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#c9d1d9",
    "terminal.background": "#0d1117",
    "terminal.foreground": "#c9d1d9",
    "terminalCursor.foreground": "#58a6ff",
    "terminal.selectionBackground": "#264f78",
    "titleBar.activeBackground": "#161b22",
    "editorWidget.background": "#1c2128",
    "list.hoverBackground": "#262c36",
    "panel.border": "#30363d",
    "input.border": "#3d444d",
    "descriptionForeground": "#8b949e",
    "disabledForeground": "#6e7681",
    "focusBorder": "#58a6ff",
    "errorForeground": "#f85149",
    "textLink.foreground": "#58a6ff",

    "terminal.ansiBlack": "#0d1117",
    "terminal.ansiRed": "#ff7b72",
    "terminal.ansiGreen": "#3fb950",
    "terminal.ansiYellow": "#d29922",
    "terminal.ansiBlue": "#58a6ff",
    "terminal.ansiMagenta": "#bc8cff",
    "terminal.ansiCyan": "#39c5cf",
    "terminal.ansiWhite": "#b1bac4",
    "terminal.ansiBrightBlack": "#6e7681",
    "terminal.ansiBrightRed": "#ffa198",
    "terminal.ansiBrightGreen": "#56d364",
    "terminal.ansiBrightYellow": "#e3b341",
    "terminal.ansiBrightBlue": "#79c0ff",
    "terminal.ansiBrightMagenta": "#d2a8ff",
    "terminal.ansiBrightCyan": "#56d4dd",
    "terminal.ansiBrightWhite": "#f0f6fc"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#8b949e", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#a5d6ff" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#79c0ff" } },
    { "scope": "keyword", "settings": { "foreground": "#ff7b72" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#39c5cf" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#d2a8ff" } },
    { "scope": "variable", "settings": { "foreground": "#ffa657" } },
    { "scope": "invalid", "settings": { "foreground": "#f85149" } }
  ]
}
