{
  "name": "Ember Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0c0c0c",
    "editor.foreground": "#e6e6e6",
    "terminal.background": "#0c0c0c",
    "terminal.foreground": "#e6e6e6",
    "terminalCursor.foreground": "#ff9d5c",
    "terminal.selectionBackground": "#3a4a63",
    "titleBar.activeBackground": "#191919",
    "editorWidget.background": "#1f1f1f",
    "list.hoverBackground": "#2a2a2a",
    "panel.border": "#2e2e2e",
    "input.border": "#3d3d3d",
    "descriptionForeground": "#9a9a9a",
    "disabledForeground": "#6b6b6b",
    "focusBorder": "#ff9d5c",
    "errorForeground": "#e05561",
    "textLink.foreground": "#4aa5f0",

    "terminal.ansiBlack": "#0c0c0c",
    "terminal.ansiRed": "#e05561",
    "terminal.ansiGreen": "#8cc265",
    "terminal.ansiYellow": "#d18f52",
    "terminal.ansiBlue": "#4aa5f0",
    "terminal.ansiMagenta": "#c162de",
    "terminal.ansiCyan": "#42b3c2",
    "terminal.ansiWhite": "#d6d6d6",
    "terminal.ansiBrightBlack": "#6b6b6b",
    "terminal.ansiBrightRed": "#ff616e",
    "terminal.ansiBrightGreen": "#a5e075",
    "terminal.ansiBrightYellow": "#f0a45d",
    "terminal.ansiBrightBlue": "#4dc4ff",
    "terminal.ansiBrightMagenta": "#de73ff",
    "terminal.ansiBrightCyan": "#4cd1e0",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#6b6b6b", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#8cc265" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#d18f52" } },
    { "scope": "keyword", "settings": { "foreground": "#c162de" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#42b3c2" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#4aa5f0" } },
    { "scope": "variable", "settings": { "foreground": "#e6e6e6" } },
    { "scope": "invalid", "settings": { "foreground": "#e05561" } }
  ]
}
