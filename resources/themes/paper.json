{
  "name": "Paper",
  "type": "light",
  "colors": {
    "editor.background": "#f8f5ee",
    "editor.foreground": "#3b3630",
    "terminal.background": "#f8f5ee",
    "terminal.foreground": "#3b3630",
    "terminalCursor.foreground": "#a04a1e",
    "terminal.selectionBackground": "#e2d9c4",
    "titleBar.activeBackground": "#ebe6da",
    "editorWidget.background": "#f2ede1",
    "list.hoverBackground": "#e4ded0",
    "panel.border": "#ddd5c4",
    "input.border": "#c4baa4",
    "descriptionForeground": "#6b6357",
    "disabledForeground": "#948b7c",
    "focusBorder": "#a04a1e",
    "errorForeground": "#b02a1f",
    "textLink.foreground": "#1f5fa8",

    "terminal.ansiBlack": "#3b3630",
    "terminal.ansiRed": "#b02a1f",
    "terminal.ansiGreen": "#4a6b18",
    "terminal.ansiYellow": "#8a6212",
    "terminal.ansiBlue": "#1f5fa8",
    "terminal.ansiMagenta": "#8a2f7b",
    "terminal.ansiCyan": "#1a6d75",
    "terminal.ansiWhite": "#6b6357",
    "terminal.ansiBrightBlack": "#948b7c",
    "terminal.ansiBrightRed": "#c94436",
    "terminal.ansiBrightGreen": "#5e8420",
    "terminal.ansiBrightYellow": "#a67c1a",
    "terminal.ansiBrightBlue": "#2f76c4",
    "terminal.ansiBrightMagenta": "#a34496",
    "terminal.ansiBrightCyan": "#26858e",
    "terminal.ansiBrightWhite": "#1a1712"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#948b7c", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#4a6b18" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#8a6212" } },
    { "scope": "keyword", "settings": { "foreground": "#8a2f7b" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#1a6d75" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#1f5fa8" } },
    { "scope": "variable", "settings": { "foreground": "#3b3630" } },
    { "scope": "invalid", "settings": { "foreground": "#b02a1f" } }
  ]
}
