{
  "name": "Ember Deep",
  "type": "dark",
  "colors": {
    "editor.background": "#0a1f22",
    "editor.foreground": "#dbe7e6",
    "terminal.background": "#0a1f22",
    "terminal.foreground": "#dbe7e6",
    "terminalCursor.foreground": "#7fd1c1",
    "terminal.selectionBackground": "#1d4a52",
    "titleBar.activeBackground": "#0d2a2e",
    "editorWidget.background": "#0f3036",
    "list.hoverBackground": "#16414a",
    "panel.border": "#1a4149",
    "input.border": "#25555f",
    "descriptionForeground": "#8fa8a8",
    "disabledForeground": "#5f7b7c",
    "focusBorder": "#7fd1c1",
    "errorForeground": "#f2777a",
    "textLink.foreground": "#6cc7e0",

    "terminal.ansiBlack": "#0a1f22",
    "terminal.ansiRed": "#f2777a",
    "terminal.ansiGreen": "#8fe3a1",
    "terminal.ansiYellow": "#e6c07b",
    "terminal.ansiBlue": "#6cc7e0",
    "terminal.ansiMagenta": "#c39ae0",
    "terminal.ansiCyan": "#7fd1c1",
    "terminal.ansiWhite": "#cfdedd",
    "terminal.ansiBrightBlack": "#5f7b7c",
    "terminal.ansiBrightRed": "#ff8d90",
    "terminal.ansiBrightGreen": "#a5f0b5",
    "terminal.ansiBrightYellow": "#f3d08c",
    "terminal.ansiBrightBlue": "#84dbf5",
    "terminal.ansiBrightMagenta": "#d5b0f0",
    "terminal.ansiBrightCyan": "#9ae6d8",
    "terminal.ansiBrightWhite": "#f0f7f6"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#5f7b7c", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#8fe3a1" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#e6c07b" } },
    { "scope": "keyword", "settings": { "foreground": "#c39ae0" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#7fd1c1" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#6cc7e0" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#7fd1c1" } },
    { "scope": "variable", "settings": { "foreground": "#dbe7e6" } },
    { "scope": "constant.language", "settings": { "foreground": "#e6c07b" } }
  ]
}
