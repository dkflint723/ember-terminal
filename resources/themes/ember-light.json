{
  "name": "Ember Light",
  "type": "light",
  "colors": {
    "editor.background": "#fdfdfc",
    "editor.foreground": "#24292e",
    "terminal.background": "#fdfdfc",
    "terminal.foreground": "#24292e",
    "terminalCursor.foreground": "#c05621",
    "terminal.selectionBackground": "#d5e5fb",
    "titleBar.activeBackground": "#eeece8",
    "editorWidget.background": "#f6f5f2",
    "list.hoverBackground": "#e6e3dd",
    "panel.border": "#dcd8d1",
    "input.border": "#c3bfb6",
    "descriptionForeground": "#5c6370",
    "disabledForeground": "#8a8f98",
    "focusBorder": "#c05621",
    "errorForeground": "#c72e2e",
    "textLink.foreground": "#1a63c4",

    "terminal.ansiBlack": "#1f1f1f",
    "terminal.ansiRed": "#c72e2e",
    "terminal.ansiGreen": "#2c7a2c",
    "terminal.ansiYellow": "#9a6700",
    "terminal.ansiBlue": "#1a63c4",
    "terminal.ansiMagenta": "#9b2fae",
    "terminal.ansiCyan": "#0f7c8c",
    "terminal.ansiWhite": "#4d4d4d",
    "terminal.ansiBrightBlack": "#767676",
    "terminal.ansiBrightRed": "#e2453f",
    "terminal.ansiBrightGreen": "#3a9b3a",
    "terminal.ansiBrightYellow": "#b8860b",
    "terminal.ansiBrightBlue": "#2a7fe0",
    "terminal.ansiBrightMagenta": "#b845c9",
    "terminal.ansiBrightCyan": "#1897a8",
    "terminal.ansiBrightWhite": "#000000"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#8a8f98", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#2c7a2c" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#9a6700" } },
    { "scope": "keyword", "settings": { "foreground": "#9b2fae" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#0f7c8c" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#1a63c4" } },
    { "scope": "variable", "settings": { "foreground": "#24292e" } },
    { "scope": "invalid", "settings": { "foreground": "#c72e2e" } }
  ]
}
